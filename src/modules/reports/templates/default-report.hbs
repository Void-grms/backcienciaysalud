<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Informe {{order.code}}</title>
  <style>
    /* @page reserva 38mm abajo para el footer fijo (firma + QR) que se
       repite en cada hoja del PDF. */
    @page { size: A4; margin: 14mm 14mm 38mm 14mm; }
    * { box-sizing: border-box; }
    body {
      font-family: 'Helvetica', 'Arial', sans-serif;
      font-size: 10pt;
      color: #111827;
      margin: 0;
    }
    .accent { color: {{lab.primaryColor}}; }
    .border-accent { border-color: {{lab.primaryColor}}; }

    .header {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 16px;
      align-items: center;
      padding-bottom: 10px;
      border-bottom: 2.5px solid {{lab.primaryColor}};
    }
    .header .logo-cell {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 130px;
    }
    .header .logo {
      max-height: 95px;
      max-width: 130px;
    }
    .header .logo-fallback {
      font-size: 22pt;
      font-weight: 800;
      color: {{lab.primaryColor}};
      letter-spacing: -0.5px;
    }
    .header .lab-info {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 2px 12px;
      align-items: end;
      font-size: 9pt;
      color: #374151;
      line-height: 1.45;
    }
    .header .lab-info .name {
      grid-column: 1 / -1;
      font-size: 15pt;
      font-weight: 800;
      color: {{lab.primaryColor}};
      letter-spacing: -0.3px;
      margin-bottom: 2px;
    }
    .header .lab-info .contact {
      grid-column: 1;
    }
    .header .lab-info .order-meta {
      grid-column: 2;
      text-align: right;
      align-self: end;
    }
    .header .lab-info .order-meta .code {
      font-family: 'Courier New', monospace;
      font-weight: 700;
      color: {{lab.primaryColor}};
      font-size: 13pt;
      letter-spacing: 0.5px;
    }
    .header .lab-info .order-meta .gen {
      font-size: 8.5pt;
      color: #6B7280;
    }

    .patient-block {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px 24px;
      margin: 14px 0 6px;
      padding: 10px 14px;
      background: #F3F4F6;
      border-left: 4px solid {{lab.primaryColor}};
    }
    .patient-block .field { font-size: 9pt; }
    .patient-block .field .label {
      color: #6B7280;
      text-transform: uppercase;
      font-size: 7.5pt;
      letter-spacing: 0.5px;
    }
    .patient-block .field .value {
      font-weight: 600;
      font-size: 10pt;
    }

    .amend-banner {
      background: #FEF3C7;
      border: 1px solid #F59E0B;
      color: #78350F;
      padding: 8px 12px;
      margin: 6px 0 10px;
      font-size: 9pt;
    }

    .category-block { margin: 14px 0; page-break-inside: avoid; }
    .category-title {
      background: {{lab.primaryColor}};
      color: #FFFFFF;
      padding: 5px 10px;
      font-weight: 700;
      font-size: 10.5pt;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .panel-title {
      background: #F3F4F6;
      color: #1F2937;
      padding: 4px 10px;
      font-weight: 700;
      font-size: 10pt;
      letter-spacing: 0.3px;
      text-transform: uppercase;
      border-bottom: 1px solid #D1D5DB;
    }

    table.results {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 9.5pt;
    }
    table.results thead th {
      background: #E5E7EB;
      color: #111827;
      text-align: left;
      padding: 5px 6px;
      font-size: 8.5pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      border-bottom: 1px solid #9CA3AF;
    }
    table.results td {
      padding: 5px 6px;
      border-bottom: 1px solid #E5E7EB;
      vertical-align: top;
    }
    /* Columnas: con y sin metodo */
    table.results.with-method .col-test  { width: 28%; }
    table.results.with-method .col-value { width: 12%; font-family: 'Courier New', monospace; }
    table.results.with-method .col-unit  { width: 10%; }
    table.results.with-method .col-range { width: 36%; }
    table.results.with-method .col-method{ width: 14%; font-size: 8.5pt; color: #4B5563; }

    table.results.no-method .col-test  { width: 34%; }
    table.results.no-method .col-value { width: 14%; font-family: 'Courier New', monospace; }
    table.results.no-method .col-unit  { width: 12%; }
    table.results.no-method .col-range { width: 40%; }

    .range-line {
      display: block;
      font-size: 9pt;
      line-height: 1.3;
    }
    .range-line.highlighted {
      font-weight: 700;
      color: #111827;
    }
    .range-line:not(.highlighted) {
      color: #4B5563;
    }

    .value-cell {
      font-size: 10.5pt;
      font-weight: 700;
    }
    .value-cell.flag-critical {
      color: #B91C1C;
      background: #FEE2E2;
      padding: 1px 4px;
    }
    .value-cell.flag-abnormal { color: #B45309; }
    .value-cell.flag-normal { color: #111827; font-weight: 600; }

    .observation {
      color: #4B5563;
      font-size: 8.5pt;
      font-style: italic;
      display: block;
      margin-top: 2px;
    }
    .flag-pill {
      display: inline-block;
      font-size: 7.5pt;
      font-weight: 700;
      letter-spacing: 0.4px;
      padding: 1px 5px;
      margin-left: 4px;
      border-radius: 3px;
    }
    .flag-pill.flag-critical { background: #FEE2E2; color: #B91C1C; }
    .flag-pill.flag-abnormal { background: #FEF3C7; color: #B45309; }

    /* Footer fijo al pie de cada hoja del PDF: firma + QR + metadata.
       Chrome ancla position:fixed al borde de la pagina (no al area de
       contenido), asi que bottom:0 lo deja pegado al fondo. El @page tiene
       margin-bottom: 38mm reservado para que el footer (~36mm) viva ahi
       sin pisar el contenido. Se repite en cada pagina. */
    .page-footer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 36mm;
      padding: 5mm 14mm 4mm;
      border-top: 1.5px solid {{lab.primaryColor}};
      background: #FFFFFF;
      display: grid;
      grid-template-columns: auto 1fr auto;
      column-gap: 16mm;
      align-items: center;
    }
    .page-footer .signatures {
      display: grid;
      grid-template-columns: repeat({{#if professionals.length}}{{professionals.length}}{{else}}1{{/if}}, auto);
      gap: 12mm;
      align-items: end;
    }
    .page-footer .signature {
      text-align: center;
      font-size: 8.5pt;
      min-width: 45mm;
    }
    .page-footer .signature img {
      max-height: 14mm;
      max-width: 45mm;
      display: block;
      margin: 0 auto 1mm;
    }
    .page-footer .signature .line {
      border-top: 1px solid #6B7280;
      padding-top: 1.5mm;
      font-weight: 700;
      font-size: 9pt;
      color: #111827;
    }
    .page-footer .signature .title {
      color: #6B7280;
      font-size: 7.5pt;
      line-height: 1.3;
    }
    .page-footer .meta {
      font-size: 7.5pt;
      color: #6B7280;
      text-align: center;
      line-height: 1.4;
    }
    .page-footer .qr-block {
      text-align: center;
      font-size: 6.5pt;
      color: #6B7280;
    }
    .page-footer .qr-block img {
      width: 22mm;
      height: 22mm;
      display: block;
      margin: 0 auto;
    }
    .page-footer .qr-block .label { margin-top: 1mm; }
  </style>
</head>
<body>
  <header class="header">
    <div class="logo-cell">
      {{#if lab.logoUrl}}
        <img class="logo" src="{{lab.logoUrl}}" alt="Logo" />
      {{else}}
        <div class="logo-fallback">{{lab.commercialName}}</div>
      {{/if}}
    </div>
    <div class="lab-info">
      <div class="name">{{lab.commercialName}}</div>
      <div class="contact">
        {{#if lab.address}}<div>{{lab.address}}</div>{{/if}}
        {{#if lab.phone}}<div>Tel: {{lab.phone}}</div>{{/if}}
        {{#if lab.taxId}}<div>RUC: {{lab.taxId}}</div>{{/if}}
      </div>
      <div class="order-meta">
        <div class="code">{{order.code}}</div>
        <div class="gen">Reporte v{{reportVersion}}</div>
        <div class="gen">Generado: {{generatedAt}}</div>
      </div>
    </div>
  </header>

  {{#if order.isAmended}}
    <div class="amend-banner">
      <strong>Informe enmendado.</strong>
      Esta version sustituye al informe anterior{{#if order.previousCode}} ({{order.previousCode}}){{/if}}.
    </div>
  {{/if}}

  <section class="patient-block">
    <div class="field">
      <div class="label">Paciente</div>
      <div class="value">{{patient.fullName}}</div>
    </div>
    <div class="field">
      <div class="label">Documento</div>
      <div class="value">{{patient.documentType}} {{patient.documentNumber}}</div>
    </div>
    <div class="field">
      <div class="label">Edad / Sexo</div>
      <div class="value">{{patient.age}} — {{patient.sex}}</div>
    </div>
    <div class="field">
      <div class="label">Fecha de muestra</div>
      <div class="value">{{order.sampleTakenAt}}</div>
    </div>
    {{#if order.requestingDoctor}}
    <div class="field">
      <div class="label">Medico solicitante</div>
      <div class="value">{{order.requestingDoctor}}</div>
    </div>
    {{/if}}
    {{#if order.reference}}
    <div class="field">
      <div class="label">Referencia</div>
      <div class="value">{{order.reference}}</div>
    </div>
    {{/if}}
  </section>

  {{#each categories}}
  <section class="category-block">
    <div class="category-title" style="background: {{categoryColor}}">{{categoryName}}</div>
    {{#each panels}}
      {{#if panelName}}
        <div class="panel-title">{{panelName}}</div>
      {{/if}}
      <table class="results {{#if ../showMethodColumn}}with-method{{else}}no-method{{/if}}">
        <thead>
          <tr>
            <th class="col-test">{{#if ../showMethodColumn}}Prueba{{else}}Análisis Clínico{{/if}}</th>
            <th class="col-value">Resultado</th>
            <th class="col-unit">{{#if ../showMethodColumn}}Unidades{{else}}Unidad{{/if}}</th>
            <th class="col-range">{{#if ../showMethodColumn}}Valores Referenciales{{else}}Rango de Referencia{{/if}}</th>
            {{#if ../showMethodColumn}}<th class="col-method">Método</th>{{/if}}
          </tr>
        </thead>
        <tbody>
          {{#each rows}}
          <tr>
            <td class="col-test">
              <div><strong>{{testName}}</strong></div>
              {{#if observation}}<span class="observation">Obs: {{observation}}</span>{{/if}}
            </td>
            <td class="col-value value-cell {{flagClass flag}}">
              {{#if (eq resultType 'numeric')}}
                {{formatNumber valueNumeric decimals}}
              {{else}}
                {{valueText}}
              {{/if}}
              {{#if (showFlagPill flag)}}<span class="flag-pill {{flagClass flag}}">{{flagShort flag}}</span>{{/if}}
            </td>
            <td class="col-unit">{{unit}}</td>
            <td class="col-range">
              {{#if ranges.length}}
                {{#each ranges}}
                  <span class="range-line {{#if highlighted}}highlighted{{/if}}">{{text}}</span>
                {{/each}}
              {{else}}
                —
              {{/if}}
            </td>
            {{#if ../../showMethodColumn}}<td class="col-method">{{method}}</td>{{/if}}
          </tr>
          {{/each}}
        </tbody>
      </table>
    {{/each}}
  </section>
  {{/each}}

  <footer class="page-footer">
    <div class="signatures">
      {{#each professionals}}
      <div class="signature">
        {{#if signatureUrl}}<img src="{{signatureUrl}}" alt="firma" />{{/if}}
        <div class="line">{{fullName}}</div>
        {{#if professionalTitle}}<div class="title">{{professionalTitle}}</div>{{/if}}
        {{#if licenseNumber}}<div class="title">{{licenseNumber}}</div>{{/if}}
      </div>
      {{/each}}
    </div>
    <div class="meta">
      Informe emitido por {{lab.commercialName}}<br />
      {{order.code}}{{#if order.validatedAt}} · Validado {{order.validatedAt}}{{/if}}
    </div>
    {{#if qrDataUrl}}
    <div class="qr-block">
      <img src="{{qrDataUrl}}" alt="Codigo QR de verificacion" />
      <div class="label">Verifica con el QR</div>
    </div>
    {{/if}}
  </footer>
</body>
</html>
