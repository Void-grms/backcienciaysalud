# --- App ---
NODE_ENV=development
PORT=3000
APP_NAME=Lab Clinico API
APP_URL=http://localhost:3000
FRONT_URL=http://localhost:5173
PUBLIC_VERIFY_URL=http://localhost:5173/verificar

# --- Base de datos ---
DATABASE_URL=postgresql://lab:lab@localhost:5434/lab?schema=public

# --- Auth (placeholder, se usa desde Sprint 1) ---
JWT_SECRET=change-me-in-production-please-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_BCRYPT_COST=12

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Email (placeholder, se usa desde Sprint 7) ---
MAIL_DRIVER=resend
MAIL_FROM="Laboratorio <no-reply@laboratorio.com>"
RESEND_API_KEY=

# --- Rate limit ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- PDF ---
CHROMIUM_PATH=

# --- Logs ---
LOG_LEVEL=info

# --- Admin seed (solo se aplica en `pnpm db:seed`) ---
SEED_ADMIN_EMAIL=admin@laboratorio.com
SEED_ADMIN_PASSWORD=Admin123!
